# Configurações do servidor
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/agenda-mental

# JWT
JWT_SECRET=sua_chave_secreta_super_segura_aqui
JWT_EXPIRE=7d

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app
EMAIL_FROM=noreply@agendamental.com

# WhatsApp API (exemplo: Twilio)
WHATSAPP_ACCOUNT_SID=seu_account_sid
WHATSAPP_AUTH_TOKEN=seu_auth_token
WHATSAPP_PHONE_NUMBER=+5511999999999

# Zoom API
ZOOM_API_KEY=sua_zoom_api_key
ZOOM_API_SECRET=sua_zoom_api_secret
ZOOM_MEETING_SDK_KEY=seu_meeting_sdk_key
ZOOM_MEETING_SDK_SECRET=seu_meeting_sdk_secret

# URL do Frontend
FRONTEND_URL=http://localhost:3000
